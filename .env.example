# =========================================================
# COPY THIS FILE TO ".env" AND FILL IN EVERY VALUE BELOW.
# NEVER commit the real ".env" file — it is already in .gitignore.
# Each teammate keeps their own local .env; only this .example is shared.
# =========================================================

# ---------- LLM ----------
# Provider you're using: anthropic | openai
LLM_PROVIDER=
# Your API key from console.anthropic.com or platform.openai.com
LLM_API_KEY=
# Model name/version you're using
LLM_MODEL=

# ---------- Database ----------
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_DB=
POSTGRES_HOST=
POSTGRES_PORT=
# Full connection string built from the values above
DATABASE_URL=

# ---------- Vector store (for Agent 3 retrieval) ----------
VECTOR_DB_PATH=
VECTOR_COLLECTION=

# ---------- Agent MCP ports ----------
AGENT1_PORT=
AGENT2_PORT=
AGENT3_PORT=
AGENT4_PORT=

# ---------- Agent MCP addresses (Streamable HTTP) ----------
AGENT2_MCP_URL=
AGENT3_MCP_URL=
AGENT1_MCP_URL=

# ---------- Security ----------
JWT_SECRET=
JWT_ALGORITHM=

# ---------- Frontend ----------
VITE_API_BASE_URL=

# ---------- Misc ----------
ENV=
LOG_LEVEL=
